{
  "name": "klontong-admin",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:frontend": "pnpm --filter ./apps/frontend dev",
    "dev:backend": "pnpm --filter ./apps/backend dev",
    "build": "pnpm -r build",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter ./apps/backend db:migrate",
    "db:deploy": "pnpm --filter ./apps/backend db:deploy",
    "db:seed": "pnpm --filter ./apps/backend db:seed",
    "db:reset": "pnpm --filter ./apps/backend db:reset",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}