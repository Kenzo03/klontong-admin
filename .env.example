# Database (docker-compose reads the POSTGRES_* values)
POSTGRES_USER=klontong
POSTGRES_PASSWORD=klontong
POSTGRES_DB=klontong
DATABASE_URL=postgresql://klontong:klontong@127.0.0.1:5432/klontong         
DATABASE_URL_TEST=postgresql://klontong:klontong@127.0.0.1:5432/klontong_test

# Backend
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=28800
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
SEED_USER_PASSWORD=KlontongAdmin!@#

# Frontend (proxy target for /api and /uploads)
NUXT_API_BASE=http://127.0.0.1:3001